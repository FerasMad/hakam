# Copy this file to .env and fill in the key. .env is gitignored - never commit it.
OPENAI_API_KEY=

# Runtime configuration. Leave HAKAM_DEVICE empty for automatic selection.
HAKAM_DEVICE=
HAKAM_RETRIEVAL_MODE=hybrid
HAKAM_MAX_UPLOAD_BYTES=209715200
HAKAM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
