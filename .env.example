# Copy this file to .env. It is gitignored; never commit secrets.
# Optional: without a key Hakam uses its deterministic grounded Arabic fallback.
OPENAI_API_KEY=

# Optional local overrides. Defaults are shown here for clarity.
HAKAM_DEVICE=
HAKAM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HAKAM_RETRIEVAL_MODE=hybrid
# HAKAM_WEIGHTS_DIR=/absolute/path/to/weights
# HAKAM_TEMP_DIR=/absolute/path/to/private/temp
